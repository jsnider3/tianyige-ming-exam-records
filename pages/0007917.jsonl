{"id": "0007917_p0044", "tianyige_id": "0007917", "title": "萬曆十年江北武舉鄉試錄", "western_year": 1582, "reign_era": "萬曆", "reign_year": 10, "exam_level": "provincial (鄉試)", "military": true, "province": "江北", "province_en": "Jiangbei", "page": 44, "scan_url": "https://commons.wikimedia.org/w/index.php?title=File%3ATianyige-330000-1705-0007917_%E8%90%AC%E6%9B%86%E5%8D%81%E5%B9%B4%E6%B1%9F%E5%8C%97%E6%AD%A6%E8%88%89%E9%84%89%E8%A9%A6%E9%8C%84_%E6%98%8E%E8%90%AC%E6%9B%86%E5%88%BB%E6%9C%AC.pdf&page=44", "text": "陵夷此夫以目論也彼習見\n夫草昧之雄昌闘闢而扶\n日月勲伐爛焉遂以此曠絕來\n禩不知奕世未嘗一日不需\n才才亦未嘗一日落也藉令\n如東方生之言時平士無所\n施才則亦以其故循習於熈\n===\n恬不獲跅弛萬里而愽通侯\n世爵之賞或有之何至遠不\n逮先臣若蓮與榏然哉\n今天下號極治然北虜啗互市\n雖守羈馽惟謹近亦數苦邉\n東南山海之孽𨯏巢掃穴而\n遺醜猶屋", "banxin": [], "ocr_model": "claude-opus-5-5 (agy, low effort)", "blank": false, "has_examiner_comments": false, "chatter_stripped": false, "alt_text": null, "alt_ocr_model": null, "agreement": null, "punctuated": null, "translation_en": null, "translation_model": null}
