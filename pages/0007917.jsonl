{"id": "0007917_p0024", "tianyige_id": "0007917", "title": "萬曆十年江北武舉鄉試錄", "western_year": 1582, "reign_era": "萬曆", "reign_year": 10, "exam_level": "provincial (鄉試)", "military": true, "province": "江北", "province_en": "Jiangbei", "page": 24, "scan_url": "https://commons.wikimedia.org/w/index.php?title=File%3ATianyige-330000-1705-0007917_%E8%90%AC%E6%9B%86%E5%8D%81%E5%B9%B4%E6%B1%9F%E5%8C%97%E6%AD%A6%E8%88%89%E9%84%89%E8%A9%A6%E9%8C%84_%E6%98%8E%E8%90%AC%E6%9B%86%E5%88%BB%E6%9C%AC.pdf&page=24", "text": "鳳陽中衛鎮撫司鎮撫李鶴齡〔子壽直隸高郵州人〕\n鳳陽右衛百戶曹遵憲〔宗文直隸合肥縣人〕\n供給官\n鳳陽府照磨鄧官寀〔允師山西蒲州人監生〕\n鳳陽府潁州吏目李見可〔允行江西玉山縣人監生〕\n鳳陽府臨淮縣主簿朱一清〔宜健江西峽江縣人監生〕\n鳳陽府鳳陽縣典史胡鳳翔〔舜儀浙江永康縣人吏員〕\n鳳陽府泗州盱眙縣典史秦朝聘〔應時江西豐城縣人吏員〕\n鳳陽府鳳陽縣王莊驛驛丞汪用賓〔國光直隸婺源縣人承差〕", "banxin": ["武舉錄　十七"], "ocr_model": "claude-opus-5-5 (agy, low effort)", "blank": false, "has_examiner_comments": false, "chatter_stripped": false, "alt_text": null, "alt_ocr_model": null, "agreement": null, "punctuated": null, "translation_en": null, "translation_model": null}
